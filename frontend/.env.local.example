NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Canonical origin for canonical tags, Open Graph URLs, JSON-LD, robots.txt and
# sitemap.xml. Defaults to https://www.artmuseumactivities.com (see lib/site.ts),
# so set this only to override for a staging domain. Bare origin, no trailing slash.
# NEXT_PUBLIC_SITE_URL=https://staging.example.com

# Umami Cloud Website ID for cookieless visitor analytics. Leave unset locally so
# dev traffic isn't counted; set it only on the Railway frontend service.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
